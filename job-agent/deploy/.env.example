# Copy to deploy/.env on the server. Never commit the real file.
#
#   cp deploy/.env.example deploy/.env
#   openssl rand -base64 24        # use the output as JAA_AUTH_PASSWORD

# ---- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Login for the web console. The container refuses to start without a password.
JAA_AUTH_USER=amol
JAA_AUTH_PASSWORD=

# ---- Where it's reachable -------------------------------------------------
# A domain you control, pointed at this server → Caddy gets HTTPS automatically.
#   JAA_SITE_ADDRESS=agent.yourdomain.com
# A bare IP over plain HTTP — only behind a VPN/Tailscale, never public.
JAA_SITE_ADDRESS=:80

# ---- Tuning ---------------------------------------------------------------
JAA_DEFAULT_MODE=review
JAA_CONCURRENCY=2
JAA_EFFORT=high
JAA_MIN_CONFIDENCE=0.35
