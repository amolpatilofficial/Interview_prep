# ---- Required -------------------------------------------------------------
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Model ----------------------------------------------------------------
JAA_MODEL=claude-opus-5
# low | medium | high | xhigh | max
JAA_EFFORT=high
# Let Anthropic re-run a policy-declined request on a fallback model.
JAA_SERVER_FALLBACKS=true

# ---- Browser --------------------------------------------------------------
# false = you SEE the browser filling the form (recommended while you tune it)
JAA_HEADLESS=false
# Reuse a logged-in browser profile (LinkedIn/Workday accounts etc.)
JAA_STORAGE_STATE=data/storage_state.json
JAA_NAV_TIMEOUT_MS=45000
JAA_SLOW_MO_MS=0
# Optional: point at a Chrome/Chromium binary instead of Playwright's own copy.
# JAA_BROWSER_EXECUTABLE=/usr/bin/google-chrome

# ---- Behaviour ------------------------------------------------------------
# dry_run  -> fill everything, screenshot, never click submit
# review   -> fill everything, pause, wait for your Approve click in the UI
# auto     -> fill and submit without asking
JAA_DEFAULT_MODE=review
JAA_CONCURRENCY=2
# Fields the model is less sure about than this are left blank in dry_run/review
JAA_MIN_CONFIDENCE=0.35

# ---- Paths ----------------------------------------------------------------
JAA_DB_PATH=data/job_agent.duckdb
JAA_PROFILE_PATH=config/profile.yaml
JAA_SCREENSHOT_DIR=data/screenshots

# ---- Web console auth -----------------------------------------------------
# Leave the password empty for localhost-only use. If it is empty, any request
# arriving from a non-loopback address is refused with a 503 rather than served.
JAA_AUTH_USER=admin
JAA_AUTH_PASSWORD=
# Set true when Chromium runs inside a container (adds --no-sandbox).
JAA_NO_SANDBOX=false
